{
    "name": "chuoauth-discord",
    "version": "0.1.0",
    "private": true,
    "description": "chuoauthのJWTを検証し、Discordサーバーで学生に認証済みロールを付与する連携サービス",
    "type": "module",
    "engines": {
        "node": ">=20"
    },
    "packageManager": "pnpm@12.15.0",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "build": "tsc -p tsconfig.build.json",
        "start": "node dist/index.js",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "format": "prettier --write ."
    },
    "dependencies": {
        "@hono/node-server": "^2.1.5",
        "better-sqlite3": "^13.0.3",
        "discord.js": "^14.28.0",
        "dotenv": "^18.0.9",
        "hono": "^4.13.16",
        "jose": "^6.2.14",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@types/better-sqlite3": "^9.6.0",
        "@types/node": "^26.6.6",
        "prettier": "^3.9.10",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2",
        "vitest": "^5.0.5"
    }
}
