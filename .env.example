# サーバー全般設定
PORT=4000
NODE_ENV=development
APP_BASE_URL=http://localhost:4000
# 連携中のセッションCookieを暗号化する秘密値 (32文字以上)
# 生成例: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=generate-a-secure-random-string-at-least-32-chars
# SQLiteファイルの保存先
DATABASE_PATH=data/chuoauth-discord.db

# Discord設定
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret
DISCORD_BOT_TOKEN=your-discord-bot-token
DISCORD_GUILD_ID=your-guild-id
DISCORD_VERIFIED_ROLE_ID=your-role-id
DISCORD_REDIRECT_URI=http://localhost:4000/auth/discord/callback

# chuoauth連携設定
# CHUOAUTH_ISSUER と CHUOAUTH_JWKS_URL は省略時 CHUOAUTH_BASE_URL から導出する
CHUOAUTH_BASE_URL=http://localhost:3000
CHUOAUTH_ISSUER=http://localhost:3000
CHUOAUTH_JWKS_URL=http://localhost:3000/.well-known/jwks.json
# chuoauth側の ALLOWED_REDIRECT_URIS にも同じ値を登録する
CHUOAUTH_REDIRECT_URI=http://localhost:4000/auth/chuoauth/callback
# chuoauth側で TOKEN_AUDIENCE を設定した場合のみ、同じ値を設定する
CHUOAUTH_AUDIENCE=
# 許可する大学ドメイン
ALLOWED_DOMAIN=g.chuo-u.ac.jp
